  "capability_types": {
    "scan_or_manual": {
      "description": "Tapping the cell opens the camera for DataMatrix or 1D barcode; decoded value is written into the cell. Manual numeric/text entry is also allowed.",
      "scan_formats": [
        "DataMatrix",
        "1D_barcode"
      ],
      "manual_entry": true,
      "write_decoded_to_cell": true
    },
    "tap_ok": {
      "description": "Tapping the cell writes the fixed text \"OK\" into the field (stamp/confirm).",
      "value": "OK",
      "manual_entry": false
    },
    "manual_date": {
      "description": "Manual date entry into the cell (datepicker or typed date).",
      "manual_entry": true,
      "value_kind": "date"
    },
    "removed": {
      "description": "Field deleted — not an interactive input."
    },
    "tap_date_settings": {
      "description": "On tap/press, write today's date in format DD.MM.YY (e.g. 15.09.26). Default date is today but user can set a different working date in settings.",
      "format": "DD.MM.YY",
      "settings_key": "stamp_date",
      "default": "today"
    },
    "tap_initials_stamp": {
      "description": "On tap/press, stamp configured user initials into the cell.",
      "settings_key": "stamp_initials"
    },
    "manual_text": {
      "description": "Opens the keyboard for free manual text/number entry into the cell.",
      "manual_entry": true
    },
    "tap_x": {
      "description": "On tap, write \"X\" into the cell (checkbox-style mark).",
      "value": "X"
    },
    "tap_lager_clerk": {
      "description": "On tap, write Sachbearbeiter Lager name from settings (default from settings) into the cell. No dialog.",
      "settings_key": "sachbearbeiterLager",
      "default": "Lager",
      "manual_entry": false
    }
  }
}
